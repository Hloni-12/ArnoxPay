@model List<ParkingArea>
@{
    ViewData["Title"] = "Parking areas";
    int total = ViewBag.TotalBays is int t ? t : 0;
    int available = ViewBag.Available is int a ? a : 0;
    int occupied = ViewBag.Occupied is int o ? o : 0;
    int pending = ViewBag.PendingPermits is int p ? p : 0;
}
<div class="section-header">
    <div>
        <p class="eyebrow">Administrator</p>
        <h1 class="page-title h2 mb-0">Parking</h1>
        <p class="text-muted mb-0">Manage areas, bays and permit approvals. Counts from SQL Server.</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-primary" asp-action="AddArea">Add parking area</a>
        <a class="btn btn-outline-secondary" asp-action="Permits">Permit applications (@pending)</a>
    </div>
</div>
<div class="row g-3 mb-4">
    <div class="col-md-3"><div class="stat-card"><div class="stat-label">Total bays</div><div class="stat-value">@total</div></div></div>
    <div class="col-md-3"><div class="stat-card"><div class="stat-label">Available</div><div class="stat-value">@available</div></div></div>
    <div class="col-md-3"><div class="stat-card"><div class="stat-label">Occupied</div><div class="stat-value">@occupied</div></div></div>
    <div class="col-md-3"><div class="stat-card"><div class="stat-label">Pending permits</div><div class="stat-value">@pending</div></div></div>
</div>
<section class="content-card">
    <h2 class="h5 fw-bold mb-3">Parking areas</h2>
    @if (Model.Any())
    {
        <table class="table table-hover mb-0">
            <thead><tr><th>Name</th><th>Location</th><th>Capacity</th><th>Bays in DB</th><th>Status</th></tr></thead>
            <tbody>
            @foreach (var area in Model)
            {
                <tr>
                    <td class="fw-semibold">@area.Name</td>
                    <td>@(area.Location ?? "—")</td>
                    <td>@area.Capacity</td>
                    <td>@area.Bays.Count</td>
                    <td>@area.Status</td>
                </tr>
            }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-state">No parking areas yet. Add an area to create bays automatically.</div>
    }
</section>
