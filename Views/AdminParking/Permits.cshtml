@model List<ParkingPermit>
@{ ViewData["Title"] = "Permit applications"; }
<div class="section-header">
    <div>
        <h1 class="page-title h2 mb-0">Permit applications</h1>
        <p class="text-muted mb-0">Approve or reject customer applications. Updates <code>ParkingPermits</code></p>
    </div>
</div>
<section class="content-card">
@if (Model.Any())
{
    <table class="table table-hover mb-0">
        <thead>
            <tr>
                <th>Permit #</th>
                <th>Customer</th>
                <th>Vehicle</th>
                <th>Accessibility</th>
                <th>Applied</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var p in Model)
        {
            var name = p.Customer?.AppUser != null ? $"{p.Customer.AppUser.FirstName} {p.Customer.AppUser.LastName}" : "#"+p.CustomerId;
            <tr>
                <td class="fw-semibold">@p.PermitNumber</td>
                <td>@name</td>
                <td>@(p.Vehicle?.RegistrationNumber ?? "—")</td>
                <td>@if (p.RequiresAccessibleParking) { <span class="badge text-bg-primary">Accessible permit requested</span> } else { <span class="text-muted">No request</span> }</td>
                <td>@p.AppliedAtUtc.ToString("dd MMM yyyy")</td>
                <td><partial name="_StatusBadge" model="@p.Status.ToString()" /></td>
                <td>
                    @if (p.Status == ParkingPermitStatus.PendingApproval)
                    {
                        <form method="post" asp-action="ReviewPermit" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@p.Id" />
                            <button name="decision" value="approve" class="btn btn-sm btn-primary">Approve</button>
                            <button name="decision" value="reject" class="btn btn-sm btn-outline-danger">Reject</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <div class="empty-state">No permit applications.</div>
}
</section>
