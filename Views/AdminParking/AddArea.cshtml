@{ ViewData["Title"] = "Add parking area"; }
<div class="content-card" style="max-width:560px;">
    <h1 class="page-title h3 mb-3">Add parking area</h1>
    <p class="text-muted">Creates the area and one bay per capacity unit (status Available) in SQL Server.</p>
    <form method="post">
        @Html.AntiForgeryToken()
        <div class="mb-3"><label class="form-label">Name</label><input name="name" class="form-control" required maxlength="120" /></div>
        <div class="mb-3"><label class="form-label">Location</label><input name="location" class="form-control" maxlength="200" /></div>
        <div class="mb-3"><label class="form-label">Capacity (bays)</label><input type="number" name="capacity" class="form-control" min="1" max="500" value="20" required /></div>
        <button class="btn btn-primary" type="submit">Create area &amp; bays</button>
        <a class="btn btn-outline-secondary ms-2" asp-action="Index">Cancel</a>
    </form>
</div>
