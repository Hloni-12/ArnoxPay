@model List<ArnoxPay.Models.StaffMessage>

@{
    ViewData["Title"] = "Staff messages";
    var peers = ViewBag.Peers as IList<ArnoxPay.Models.AppUser>
        ?? new List<ArnoxPay.Models.AppUser>();
    var names = ViewBag.Users as IReadOnlyDictionary<string, string>
        ?? new Dictionary<string, string>();
}

<div class="content-card">
    <h1 class="h2">Administrator–Financial Officer messages</h1>
    <p class="text-muted">
        Messages are visible only to the two staff roles. Unread incoming messages are marked read when the conversation opens.
    </p>

    <div class="vstack gap-3 my-4">
        @foreach (var message in Model)
        {
            var senderName = names.TryGetValue(message.SenderUserId, out var displayName)
                ? displayName
                : message.SenderUserId;

            <article class="p-3 rounded border">
                <div class="small text-muted">
                    @senderName · @message.SentAtUtc.ToLocalTime().ToString("g")
                </div>
                <p class="mb-0">@message.Body</p>
            </article>
        }

        @if (!Model.Any())
        {
            <p class="text-muted">No conversation history yet.</p>
        }
    </div>

    @if (peers.Any())
    {
        <form asp-action="Send" method="post">
            <div class="mb-3">
                <label class="form-label" for="recipientUserId">Send to</label>
                <select id="recipientUserId" name="recipientUserId" class="form-select" required>
                    @foreach (var peer in peers)
                    {
                        <option value="@peer.Id">@peer.FirstName @peer.LastName (@peer.Email)</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label" for="body">Message</label>
                <textarea class="form-control" id="body" name="body" maxlength="2000" required rows="4"></textarea>
            </div>

            <button class="btn btn-primary" type="submit">Send message</button>
        </form>
    }
    else
    {
        <div class="alert alert-warning">
            No recipient account in the other staff role exists yet.
        </div>
    }
</div>
