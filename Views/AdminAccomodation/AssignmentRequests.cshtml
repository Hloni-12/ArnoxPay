@model List<AccommodationAssignmentRequest>
@{ ViewData["Title"] = "Residence requests"; }
<div class="mb-4"><h1 class="page-title h2 mb-1">Residence requests</h1><p class="text-muted mb-0">Approve or reject student and staff requests to reside in a specific accomodation.</p></div><section class="content-card p-0 overflow-hidden">@if(Model.Any()){<div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Customer</th><th>Accomodation</th><th>Requested</th><th>Customer note</th><th>Status</th><th class="text-end">Review</th></tr></thead><tbody>@foreach(var request in Model){<tr><td>@request.Customer?.AppUser?.FirstName @request.Customer?.AppUser?.LastName<br/><small>@request.Customer?.UniversityNumber</small></td><td>@request.Accomodation?.Name<br/><small>Unit @request.Accomodation?.UnitNumber</small></td><td>@request.RequestedAtUtc.ToLocalTime().ToString("dd MMM yyyy")</td><td>@request.CustomerNote</td><td><partial name="_StatusBadge" model="@request.Status.ToString()"/></td><td class="text-end">@if(request.Status==AccommodationAssignmentStatus.Pending){<form asp-action="ReviewAssignment" method="post" class="d-inline"><input name="Id" value="@request.Id" type="hidden"/><input name="AdministratorNote" class="form-control form-control-sm d-inline-block mb-1" style="width:150px" placeholder="Administrator note"/><button name="Status" value="@AccommodationAssignmentStatus.Approved" class="btn btn-sm btn-success">Approve</button><button name="Status" value="@AccommodationAssignmentStatus.Rejected" class="btn btn-sm btn-outline-danger">Reject</button></form>}else{<small>@request.AdministratorNote</small>}</td></tr>}</tbody></table></div>}else{<div class="empty-state">No residence requests have been submitted.</div>}</section>
