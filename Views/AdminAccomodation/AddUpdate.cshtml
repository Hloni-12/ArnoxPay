@model AccomodationEditModel
@{ ViewData["Title"] = Model.Id == 0 ? "Add accomodation" : "Edit accomodation"; }
<div class="content-card mx-auto" style="max-width:820px"><h1 class="page-title h3">@(Model.Id == 0 ? "Add accomodation" : "Edit accomodation")</h1><form method="post" class="row g-3"><input asp-for="Id" type="hidden"/><div asp-validation-summary="ModelOnly" class="text-danger col-12"></div><div class="col-md-8"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" placeholder="Example: Riverside Student Flats"/></div><div class="col-md-4"><label asp-for="UnitNumber" class="form-label"></label><input asp-for="UnitNumber" class="form-control"/></div><div class="col-md-6"><label asp-for="AccommodationType" class="form-label"></label><select asp-for="AccommodationType" asp-items="Html.GetEnumSelectList<AccommodationType>()" class="form-select"></select></div><div class="col-md-6"><label asp-for="Capacity" class="form-label"></label><input asp-for="Capacity" class="form-control" min="1" max="20"/></div><div class="col-12"><label asp-for="Address" class="form-label"></label><input asp-for="Address" class="form-control"/></div><div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="4" placeholder="Describe the residence, facilities, and useful information for students and staff."></textarea></div><div class="col-12"><div class="form-check"><input asp-for="IsActive" class="form-check-input"/><label asp-for="IsActive" class="form-check-label">Publish this accomodation to students and staff</label></div></div><div class="col-12"><button class="btn btn-primary">Save accomodation</button><a class="btn btn-outline-secondary ms-2" asp-action="List">Cancel</a></div></form></div>
