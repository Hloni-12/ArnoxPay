@model AccommodationIssueUpdateModel
@{
	ViewData["Title"] = "Update accommodation issue"; 
}
<div class="content-card mx-auto" style="max-width:720px">
	<h1 class="page-title h3">Update accommodation issue</h1>
	<form method="post" class="row g-3">
		<input asp-for="Id" type="hidden"/>
		<div class="col-md-5">
			<label asp-for="Status" class="form-label"></label>
			<select asp-for="Status" asp-items="Html.GetEnumSelectList<AccommodationIssueStatus>()" class="form-select"></select>
		</div>
			<div class="col-12">
				<label asp-for="ResolutionNote" class="form-label"></label>
				<textarea asp-for="ResolutionNote" class="form-control" rows="5" placeholder="Describe the maintenance action or resolution for the resident."></textarea>
			</div>
			<div class="col-12">
				<button class="btn btn-primary">Save issue update</button>
				<a class="btn btn-outline-secondary ms-2" asp-action="Issues">Cancel</a>
			</div>
	</form>
</div>
