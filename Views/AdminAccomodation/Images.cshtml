@model Accomodation
@{ ViewData["Title"] = "Accommodation images"; }
<div class="d-flex justify-content-between align-items-end mb-4"><div><h1 class="page-title h2 mb-1">Images: @Model.Name</h1><p class="text-muted mb-0">Upload real photos for students and staff to view before requesting residence.</p></div><a class="btn btn-outline-secondary" asp-action="List">Back to accomodations</a></div><div class="row g-4"><div class="col-lg-4"><section class="content-card"><h2 class="h5">Upload image</h2><form asp-action="UploadImage" method="post" enctype="multipart/form-data"><input name="AccomodationId" value="@Model.Id" type="hidden"/><div class="mb-3"><label class="form-label">Image file</label><input class="form-control" name="ImageFile" type="file" accept=".jpg,.jpeg,.png,.webp" required/></div><div class="mb-3"><label class="form-label">Caption</label><input class="form-control" name="Caption" maxlength="160"/></div><div class="form-check mb-3"><input class="form-check-input" id="IsPrimary" name="IsPrimary" type="checkbox" value="true"/><label class="form-check-label" for="IsPrimary">Use as primary image</label></div><button class="btn btn-primary">Upload image</button></form></section></div><div class="col-lg-8"><div class="row g-3">@if(Model.Images.Any()){@foreach(var image in Model.Images.OrderByDescending(x=>x.IsPrimary)){<div class="col-sm-6"><div class="content-card p-2"><img src="@image.ImagePath" alt="@image.Caption" class="admin-image"/><div class="p-2 d-flex justify-content-between gap-2"><small>@(image.IsPrimary ? "Primary image" : image.Caption)</small><form asp-action="DeleteImage" asp-route-id="@image.Id" method="post"><button class="btn btn-sm btn-outline-danger">Delete</button></form></div></div></div>}}else{<div class="col-12"><div class="empty-state content-card">No images have been uploaded.</div></div>}</div></div></div>
