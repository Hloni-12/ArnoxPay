@model List<ArnoxPay.Models.StaffNotification>
@{ViewData["Title"]="Notifications";}
<div class="content-card"><h1 class="h2">Notifications</h1>@if(!Model.Any()){<p class="text-muted">You have no notifications.</p>}@foreach(var n in Model){<form asp-action="Open" method="post" class="border rounded p-3 mb-2 @(n.IsRead?"":"border-primary")"><input type="hidden" name="id" value="@n.Id"/><button class="btn btn-link text-start text-decoration-none p-0 w-100"><div class="d-flex justify-content-between"><strong>@n.Title @if(!n.IsRead){<span class="badge text-bg-primary">Unread</span>}</strong><small>@n.CreatedAtUtc.ToLocalTime().ToString("g")</small></div><span class="text-body">@n.Message</span></button></form>}</div>
