@model List<FinancialOfficer>
@{ ViewData["Title"] = "Financial officers"; }<div class="d-flex justify-content-between align-items-end mb-4"><div><h1 class="page-title h2 mb-1">Financial officers</h1><p class="text-muted mb-0">Authorize officers to review payment transactions.</p></div><a class="btn btn-primary" asp-action="AddUpdate">Add financial officer</a></div><section class="content-card p-0 overflow-hidden">@if(Model.Any()){<div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Officer</th><th>Employee no.</th><th>Status</th><th class="text-end">Authorization</th></tr></thead><tbody>@foreach(var o in Model){<tr><td><strong>@o.AppUser?.FirstName @o.AppUser?.LastName</strong><br/><small>@o.AppUser?.Email</small></td><td>@o.EmployeeNumber</td><td>@(o.IsAuthorized ? "Authorized" : "Disabled")</td><td class="text-end"><form asp-action="ToggleAuthorization" asp-route-id="@o.Id" method="post"><button class="btn btn-sm @(o.IsAuthorized ? "btn-outline-danger" : "btn-outline-success")">@(o.IsAuthorized ? "Disable" : "Authorize")</button></form></td></tr>}</tbody></table></div>}else{<div class="empty-state">No financial officers have been added.</div>}</section>
