@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var accName = ViewData["AccommodationName"] as string;
    var accUnit = ViewData["AccommodationUnit"] as string;
    var hasAccommodation = !string.IsNullOrWhiteSpace(accName);

    var displayName = !string.IsNullOrWhiteSpace(Model.FirstName)
        ? Model.FirstName.Trim()
        : (!string.IsNullOrWhiteSpace(Model.FullName)
            ? Model.FullName.Trim().Split(' ')[0]
            : string.Empty);
    var welcomeHeading = string.IsNullOrWhiteSpace(displayName)
        ? "Welcome!"
        : $"Welcome, {displayName}!";
}

<section class="fx-welcome">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 position-relative" style="z-index:1">
        <div>
            <h1 class="mb-2">@welcomeHeading</h1>
            <p class="mb-0">
                Here&rsquo;s an overview of your ArnoxPay account.
                Track payments, accommodation and notifications from one place.
            </p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-light" asp-controller="Services" asp-action="Index">
                <i class="fa-solid fa-grid-2 me-1" aria-hidden="true"></i> Explore Services
            </a>
            <a class="btn btn-outline-light" asp-controller="Accomodation" asp-action="List">View Accommodation</a>
        </div>
    </div>
</section>

<div class="fx-overview">
    <div class="fx-metric paid">
        <div class="label">Total paid</div>
        <div class="value">@Model.AcceptedTotal.ToString("C")</div>
        <div class="hint">@Model.AcceptedPayments completed payment(s)</div>
    </div>
    <div class="fx-metric outstanding">
        <div class="label">Outstanding</div>
        <div class="value">@Model.PendingPayments</div>
        <div class="hint">Request(s) awaiting review</div>
    </div>
    <div class="fx-metric pending">
        <div class="label">Attention</div>
        <div class="value">@(Model.PendingPayments > 0 ? Model.PendingPayments : 0)</div>
        <div class="hint">@(Model.PendingPayments > 0 ? "Pending reviews" : "You're up to date")</div>
    </div>
</div>

@if (hasAccommodation)
{
    <section class="content-card mb-4">
        <div class="d-flex flex-wrap justify-content-between gap-2 align-items-center">
            <div>
                <h2 class="h6 fw-bold mb-1">Your accommodation</h2>
                <p class="mb-0 fw-semibold">@accName</p>
                @if (!string.IsNullOrWhiteSpace(accUnit))
                {
                    <p class="text-muted small mb-0">Unit @accUnit</p>
                }
            </div>
            <a class="btn btn-outline-primary btn-sm" asp-controller="Accomodation" asp-action="List">View accommodation</a>
        </div>
    </section>
}
else
{
    <section class="content-card mb-4">
        <div class="d-flex flex-wrap justify-content-between gap-2 align-items-center">
            <div>
                <h2 class="h6 fw-bold mb-1">Accommodation</h2>
                <p class="text-muted small mb-0">No accommodation assigned yet.</p>
            </div>
            <a class="btn btn-outline-primary btn-sm" asp-controller="Accomodation" asp-action="List">Explore accommodation</a>
        </div>
    </section>
}

<section class="content-card">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
        <h2 class="h5 fw-bold mb-0">Recent payment activity</h2>
        <a class="btn btn-sm btn-outline-secondary" asp-controller="Payment" asp-action="MyPayments">Payment history</a>
        <a class="btn btn-sm btn-outline-primary" asp-controller="Payment" asp-action="CampusBalance">Campus balance</a>
    </div>
    @if (Model.RecentPayments.Any())
    {
        <ul class="fx-timeline">
        @foreach (var p in Model.RecentPayments)
        {
            var dot = p.Status == PaymentStatus.Accepted ? "ok" : p.Status == PaymentStatus.Rejected ? "fail" : "wait";
            var statusClass = p.Status == PaymentStatus.Accepted ? "completed" : p.Status == PaymentStatus.Rejected ? "failed" : "pending";
            var statusText = p.Status == PaymentStatus.Accepted ? "Completed" : p.Status == PaymentStatus.Rejected ? "Rejected" : "Pending";
            <li>
                <span class="fx-dot @dot" aria-hidden="true"></span>
                <div>
                    <div class="title">@p.PaymentType</div>
                    <div class="meta">@p.SubmittedAtUtc.ToString("dd MMM yyyy") · Ref @p.AccountReference</div>
                    <span class="fx-status @statusClass mt-1">
                        @if (p.Status == PaymentStatus.Accepted)
                        { <i class="fa-solid fa-circle-check" aria-hidden="true"></i> }
                        else if (p.Status == PaymentStatus.Rejected)
                        { <i class="fa-solid fa-circle-xmark" aria-hidden="true"></i> }
                        else
                        { <i class="fa-solid fa-clock" aria-hidden="true"></i> }
                        @statusText
                    </span>
                </div>
                <div class="amount">@p.Amount.ToString("C")</div>
            </li>
        }
        </ul>
    }
    else
    {
        <div class="empty-state py-4">
            No payment activity yet.
            <a asp-controller="Services" asp-action="Index">Explore services</a> to make a payment.
        </div>
    }
</section>
