@{
    ViewData["Title"] = "Smart Parking";
    var fullName = ViewData["FullName"] as string ?? "Customer";
    var bays = ViewBag.Bays as List<ParkingBay> ?? new List<ParkingBay>();
    var vehicles = ViewBag.Vehicles as List<Vehicle> ?? new List<Vehicle>();
    var activePermit = ViewBag.ActivePermit as ParkingPermit;
    int total = ViewBag.Total is int t ? t : 0;
    int available = ViewBag.Available is int a ? a : 0;
    int occupied = ViewBag.Occupied is int o ? o : 0;
    int reserved = ViewBag.Reserved is int r ? r : 0;
    double pct = total > 0 ? (available * 100.0 / total) : 0;
}

<div class="section-header">
    <div>
        <p class="eyebrow">Smart Parking</p>
        <h1 class="page-title h2 mb-0">Parking availability</h1>
        <p class="text-muted mb-0">Live campus parking status from SQL Server. Register vehicles and apply for permits to use estate parking.</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-primary" asp-controller="Vehicle" asp-action="Index">My vehicles</a>
        <a class="btn btn-outline-secondary" asp-controller="Customer" asp-action="Permit">Permits</a>
    </div>
</div>

@if (total == 0)
{
    <div class="alert alert-info">
        No parking bays in the database yet. An administrator must add parking areas and bays (see Admin · Parking). Until then availability shows zero.
    </div>
}

<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="parking-visual">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <div>
                    <h2 class="h5 fw-bold mb-1">Campus parking map</h2>
                    <p class="text-muted small mb-0">@available / @total spaces available</p>
                </div>
                <div class="progress" style="width:160px;height:8px;border-radius:999px;">
                    <div class="progress-bar" style="width:@(pct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;background:var(--arnox-grad);"></div>
                </div>
            </div>
            @if (bays.Any())
            {
                <div class="parking-grid">
                    @foreach (var bay in bays.Take(80))
                    {
                        var cls = bay.Status switch
                        {
                            ParkingBayStatus.Available => "available",
                            ParkingBayStatus.Occupied => "occupied",
                            ParkingBayStatus.Reserved => "reserved",
                            _ => "occupied"
                        };
                        if (bay.Status == ParkingBayStatus.Maintenance) { cls = "occupied"; }
                        <div class="parking-slot @cls" title="@bay.BayNumber — @bay.Status">@bay.BayNumber</div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state py-4">No bays to display. Add ParkingAreas and ParkingBays in the database.</div>
            }
            <div class="parking-legend">
                <span><i style="background:#22C55E;"></i> Available (@available)</span>
                <span><i style="background:#94A3B8;"></i> Occupied (@occupied)</span>
                <span><i style="background:#F59E0B;"></i> Reserved (@reserved)</span>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="dash-card mb-3">
            <div class="card-icon"><i class="fa-solid fa-car"></i></div>
            <div class="card-title">Your vehicles</div>
            <p class="fw-bold mb-2">@vehicles.Count registered</p>
            @if (activePermit != null)
            {
                <p class="card-meta mb-1">Permit status</p>
                <span class="status-pill status-success mb-2 d-inline-flex">@activePermit.Status</span>
                <p class="card-meta mb-0">@activePermit.Vehicle?.RegistrationNumber · expires @activePermit.ExpiryDate.ToString("dd MMM yyyy")</p>
            }
            else
            {
                <span class="status-pill status-neutral mb-2 d-inline-flex">No active permit</span>
                <p class="text-muted small mb-0">Apply for a permit after registering a vehicle.</p>
            }
            <p class="text-muted small mt-3 mb-3">First vehicle included. Second vehicle requires second-car parking permit payment.</p>
            <a class="btn btn-primary btn-sm" asp-controller="Vehicle" asp-action="Index">Manage vehicles</a>
        </div>
        <div class="content-card">
            <h3 class="h6 fw-bold">Quick actions</h3>
            <div class="d-grid gap-2">
                <a class="btn btn-outline-primary btn-sm" asp-controller="Customer" asp-action="ApplyPermit">Apply for permit</a>
                <a class="btn btn-outline-secondary btn-sm" asp-controller="Payment" asp-action="AddUpdate">Pay parking fee</a>
            </div>
        </div>
    </div>
</div>

<section class="content-card mb-4">
    <h2 class="h5 fw-bold mb-3">Gate access process</h2>
    <p class="text-muted mb-4">Entry uses your digital permit. Access is denied if the permit is expired, suspended or revoked — no automatic payment is charged on denial.</p>
    <div class="gate-flow">
        <div class="gate-step"><div class="step-num">1</div><div class="step-icon"><i class="fa-solid fa-car-side"></i></div><div class="step-label">Vehicle approaches</div></div>
        <div class="gate-arrow"><i class="fa-solid fa-chevron-right"></i></div>
        <div class="gate-step"><div class="step-num">2</div><div class="step-icon"><i class="fa-solid fa-qrcode"></i></div><div class="step-label">Permit / QR scanned</div></div>
        <div class="gate-arrow"><i class="fa-solid fa-chevron-right"></i></div>
        <div class="gate-step"><div class="step-num">3</div><div class="step-icon"><i class="fa-solid fa-id-card"></i></div><div class="step-label">Permit verified</div></div>
        <div class="gate-arrow"><i class="fa-solid fa-chevron-right"></i></div>
        <div class="gate-step"><div class="step-num">4</div><div class="step-icon"><i class="fa-solid fa-check-circle"></i></div><div class="step-label">Access granted</div></div>
        <div class="gate-arrow"><i class="fa-solid fa-chevron-right"></i></div>
        <div class="gate-step"><div class="step-num">5</div><div class="step-icon"><i class="fa-solid fa-road-barrier"></i></div><div class="step-label">Boom opens</div></div>
    </div>
</section>
