@model List<ServiceReview>
@{
    ViewData["Title"] = "Ratings & reviews";
    var fullName = ViewData["FullName"] as string ?? "Customer";
}

<div class="section-header">
    <div>
        <p class="eyebrow">Feedback</p>
        <h1 class="page-title h2 mb-0">Ratings &amp; reviews</h1>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <section class="content-card">
            <h2 class="h5 fw-bold mb-3">Submit a review</h2>
            <form method="post" asp-action="Reviews">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label">Category</label>
                    <select name="category" class="form-select">
                        <option value="General">General</option>
                        <option value="Payments">Payments</option>
                        <option value="Parking">Parking</option>
                        <option value="Accommodation">Accommodation</option>
                        <option value="Support">Support</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Rating</label>
                    <div class="d-flex gap-2 flex-wrap">
                        @for (int i = 5; i >= 1; i--)
                        {
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="rating" id="rating@i" value="@i" @(i == 5 ? "checked" : "") />
                                <label class="form-check-label" for="rating@i">@i ★</label>
                            </div>
                        }
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Your review</label>
                    <textarea name="comment" class="form-control" rows="4" maxlength="1000" required placeholder="What worked well? What could improve?"></textarea>
                </div>
                <button type="submit" class="btn btn-primary">Submit review</button>
            </form>
        </section>
    </div>
    <div class="col-lg-7">
        <section class="content-card">
            <h2 class="h5 fw-bold mb-3">Your previous reviews</h2>
            @if (Model != null && Model.Any())
            {
                <div class="list-group list-group-flush">
                    @foreach (var r in Model)
                    {
                        <div class="list-group-item px-0 py-3 border-bottom">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <div>
                                    <span class="status-pill status-neutral me-2">@r.Category</span>
                                    <span class="text-warning fw-bold">@string.Concat(Enumerable.Repeat("★", r.Rating))</span>
                                    <span class="text-muted small">(@r.Rating/5)</span>
                                </div>
                                <span class="text-muted small">@r.CreatedAtUtc.ToString("dd MMM yyyy")</span>
                            </div>
                            <p class="mb-0 mt-2">@r.Comment</p>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state py-4">
                    <p class="mb-0">You have not submitted any reviews yet.</p>
                </div>
            }
        </section>
    </div>
</div>
