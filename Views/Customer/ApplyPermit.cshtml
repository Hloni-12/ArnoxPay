@{
    ViewData["Title"] = "Apply for permit";
    var vehicles = ViewBag.Vehicles as List<Vehicle> ?? new List<Vehicle>();
}
<div class="section-header">
    <div>
        <p class="eyebrow">Permits</p>
        <h1 class="page-title h2 mb-0">Apply for parking permit</h1>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Permit">Back</a>
</div>

@if (!vehicles.Any())
{
    <div class="alert alert-warning">You must <a asp-controller="Vehicle" asp-action="Index">register a vehicle</a> before applying for a permit.</div>
}
else
{
    <section class="content-card" style="max-width:560px;">
        <form method="post" asp-action="ApplyPermit">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label">Vehicle</label>
                <select name="vehicleId" class="form-select" required>
                    @foreach (var v in vehicles)
                    {
                        <option value="@v.Id">@v.RegistrationNumber @(string.IsNullOrWhiteSpace(v.Make) ? "" : $"— {v.Make} {v.Model}")</option>
                    }
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">Permit type</label>
                <select name="permitType" class="form-select">
                    <option>Student annual</option>
                    <option>Staff annual</option>
                    <option>Semester</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">Fee (R)</label>
                <input type="number" name="fee" class="form-control" min="0" step="0.01" value="0" />
                <div class="form-text">Set by estate policy. Extra vehicles may require a separate Parking payment.</div>
            </div>
            <button type="submit" class="btn btn-primary">Submit application</button>
        </form>
    </section>
}
