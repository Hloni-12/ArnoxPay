@{
    ViewData["Title"] = "Apply for parking permit";
    var vehicles = ViewBag.Vehicles as List<Vehicle> ?? new List<Vehicle>();
}
<div class="section-header">
    <div>
        <p class="eyebrow">Permits</p>
        <h1 class="page-title h2 mb-0">Apply for parking permit</h1>
    </div>
    <a class="btn-arnox btn-arnox-outline" asp-action="Permit">
        <i class="fa-solid fa-arrow-left"></i> Back
    </a>
</div>

@if (!vehicles.Any())
{
    <div class="alert alert-warning">
        You must <a asp-controller="Vehicle" asp-action="Index" class="fw-semibold">register a vehicle</a> before applying for a permit.
    </div>
}
else
{
    <section class="content-card" style="max-width:560px;">
        <div class="alert alert-success mb-3 d-flex align-items-start gap-2">
            <i class="fa-solid fa-circle-check fs-5 mt-1"></i>
            <div>
                <strong>Permit application fee: R0.00</strong><br />
                Applying for a parking permit is free of charge. No payment is required or created for the application itself.
                Approval is still required from an authorised officer.
            </div>
        </div>
        <form method="post" asp-action="ApplyPermit">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label">Vehicle</label>
                <select name="vehicleId" class="form-select" required>
                    @foreach (var v in vehicles)
                    {
                        <option value="@v.Id">@v.RegistrationNumber @(string.IsNullOrWhiteSpace(v.Make) ? "" : $"— {v.Make} {v.Model}")</option>
                    }
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">Permit type</label>
                <select name="permitType" class="form-select">
                    <option>Student annual</option>
                    <option>Staff annual</option>
                    <option>Semester</option>
                </select>
            </div>
            <fieldset class="mb-4">
                <legend class="form-label h6">Do you require an accessible parking permit?</legend>
                <div class="form-check form-check-inline"><input class="form-check-input" type="radio" name="requiresAccessibleParking" id="accessibleParkingYes" value="true"/><label class="form-check-label" for="accessibleParkingYes">Yes</label></div>
                <div class="form-check form-check-inline"><input class="form-check-input" type="radio" name="requiresAccessibleParking" id="accessibleParkingNo" value="false" checked/><label class="form-check-label" for="accessibleParkingNo">No</label></div>
                <div class="form-text">Choose Yes if the permit is for a person with disability-related access needs. No diagnosis details are needed.</div>
            </fieldset>
            <div class="mb-4">
                <label class="form-label">Amount payable</label>
                <input type="text" class="form-control fw-bold text-success" value="R0.00" readonly />
                <input type="hidden" name="fee" value="0" />
                <div class="form-text">No charge for the application. Separate parking usage fees (if any) remain independent.</div>
            </div>
            <div class="btn-group-arnox">
                <button type="submit" class="btn-arnox btn-arnox-primary btn-arnox-lg">
                    <i class="fa-solid fa-paper-plane"></i> Submit free application
                </button>
            </div>
        </form>
    </section>
}
