@model CustomerEditModel
@{ ViewData["Title"] = "Edit customer"; }
<div class="content-card mx-auto" style="max-width:760px">
    <h1 class="page-title h3">Edit customer</h1>
    <p class="text-muted">Update customer details. User Number cannot be changed.</p>
    <form method="post" class="row g-3">
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger col-12"></div>
        <div class="col-md-6">
            <label class="form-label">User Number</label>
            <input class="form-control" value="@Model.UserNumber" readonly />
        </div>
        <div class="col-md-6">
            <label asp-for="Category" class="form-label"></label>
            <select asp-for="Category" asp-items="Html.GetEnumSelectList<CustomerCategory>()" class="form-select"></select>
        </div>
        <div class="col-md-6">
            <label asp-for="FirstName" class="form-label"></label>
            <input asp-for="FirstName" class="form-control" />
        </div>
        <div class="col-md-6">
            <label asp-for="LastName" class="form-label"></label>
            <input asp-for="LastName" class="form-control" />
        </div>
        <div class="col-md-6">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" />
        </div>
        <div class="col-md-6">
            <label asp-for="PhoneNumber" class="form-label"></label>
            <input asp-for="PhoneNumber" class="form-control" />
        </div>
        <div class="col-md-6">
            <label asp-for="UniversityNumber" class="form-label"></label>
            <input asp-for="UniversityNumber" class="form-control" />
        </div>
        <div class="col-12">
            <label asp-for="ResidentialAddress" class="form-label"></label>
            <input asp-for="ResidentialAddress" class="form-control" />
        </div>
        <div class="col-12">
            <button class="btn btn-primary">Save changes</button>
            <a class="btn btn-outline-secondary ms-2" asp-action="List">Cancel</a>
        </div>
    </form>
</div>
