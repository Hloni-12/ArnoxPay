@model ArnoxPay.Models.ViewModels.ContactStaffModel
@{ ViewData["Title"]="Contact staff"; }
<section class="content-card mx-auto" style="max-width:760px"><h1 class="h2">Email the office</h1><p class="text-muted">Select the Administrator or Financial Officer. Delivery requires the site's SMTP settings.</p><form asp-action="Index" method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-6"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control"/><span asp-validation-for="Name" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control"/><span asp-validation-for="Email" class="text-danger"></span></div><div class="col-md-6"><label asp-for="RecipientRole" class="form-label">Send to</label><select asp-for="RecipientRole" class="form-select"><option value="">Choose a staff role</option><option value="Administrator">Administrator</option><option value="Financial Officer">Financial Officer</option></select><span asp-validation-for="RecipientRole" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Subject" class="form-label"></label><input asp-for="Subject" class="form-control"/><span asp-validation-for="Subject" class="text-danger"></span></div><div class="col-12"><label asp-for="Message" class="form-label"></label><textarea asp-for="Message" class="form-control" rows="6"></textarea><span asp-validation-for="Message" class="text-danger"></span></div><div class="col-12"><button class="btn btn-primary">Send message</button></div></div></form></section>
