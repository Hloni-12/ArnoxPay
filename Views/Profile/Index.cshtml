@model CustomerEditModel
@{
    ViewData["Title"] = "My profile";
}
<div class="content-card mx-auto" style="max-width:760px">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
        <div>
            <h1 class="page-title h3 mb-1">My profile</h1>
            <p class="text-muted mb-0">View your User Number and account type. Update permitted personal details.</p>
        </div>
        <a class="btn btn-outline-primary btn-sm" asp-action="ChangePassword">Change password</a>
    </div>

    <form method="post" class="row g-3">
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger col-12"></div>

        <div class="col-md-6">
            <label class="form-label">User Number</label>
            <input class="form-control" value="@Model.UserNumber" readonly />
            <div class="form-text">Used to sign in. Cannot be changed.</div>
        </div>
        <div class="col-md-6">
            <label class="form-label">Account type</label>
            <input class="form-control" value="@Model.Category" readonly />
            <div class="form-text">Student or Staff under the Customer role.</div>
        </div>

        <div class="col-md-6">
            <label asp-for="FirstName" class="form-label"></label>
            <input asp-for="FirstName" class="form-control" />
            <span asp-validation-for="FirstName" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="LastName" class="form-label"></label>
            <input asp-for="LastName" class="form-control" />
            <span asp-validation-for="LastName" class="text-danger small"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger small"></span>
            <div class="form-text">Notifications are sent to this address.</div>
        </div>
        <div class="col-md-6">
            <label asp-for="PhoneNumber" class="form-label"></label>
            <input asp-for="PhoneNumber" class="form-control" />
            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="UniversityNumber" class="form-label"></label>
            <input asp-for="UniversityNumber" class="form-control" />
            <span asp-validation-for="UniversityNumber" class="text-danger small"></span>
        </div>
        <div class="col-12">
            <label asp-for="ResidentialAddress" class="form-label"></label>
            <input asp-for="ResidentialAddress" class="form-control" />
        </div>

        <div class="col-12">
            <button type="submit" class="btn btn-primary">Save profile</button>
        </div>
    </form>
</div>
