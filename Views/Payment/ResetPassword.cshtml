@{ ViewData["Title"] = "Reset customer password"; var customer = ViewBag.Customer as Customer; }<div class="auth-card mx-auto" style="max-width:580px"><h1 class="page-title h3">Reset customer password</h1><p class="text-muted">Set a temporary password for <strong>@customer?.AppUser?.FirstName @customer?.AppUser?.LastName</strong> and share it through an approved secure channel.</p><form method="post"><input name="id" type="hidden" value="@customer?.Id"/><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="mb-3"><label class="form-label">New password</label><input class="form-control" name="newPassword" type="password" minlength="8" required/></div><div class="mb-3"><label class="form-label">Confirm password</label><input class="form-control" name="confirmPassword" type="password" minlength="8" required/></div><button class="btn btn-primary">Reset password</button><a class="btn btn-outline-secondary ms-2" asp-action="Customers">Cancel</a></form></div>
