@model Payment
@{
    Layout = null;
    ViewData["Title"] = "Payment Receipt";
    if (Model.Status != PaymentStatus.Accepted)
    {
        // Safety: never present a successful receipt for non-paid payments
        Context.Response.Redirect(Url.Action("Result", "Payment", new { id = Model.Id })!);
        return;
    }
    var user = Model.Customer?.AppUser;
    var fullName = user != null ? $"{user.FirstName} {user.LastName}".Trim() : "Customer";
    var studentNo = Model.Customer?.UserNumber ?? "—";
    var receiptNo = Model.TransactionReference ?? Model.Transaction?.TransactionReference ?? $"ARN-RCP-{Model.Id:D6}";
    var paidAt = Model.CompletedAtUtc ?? Model.Transaction?.CompletedAtUtc ?? Model.ReviewedAtUtc ?? Model.SubmittedAtUtc;
    var fee = 0m;
    var total = Model.Amount + fee;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Receipt @receiptNo - ArnoxPay</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body { font-family: Inter, system-ui, sans-serif; background: #f1f5f9; padding: 1.5rem; color: #0f172a; }
        .sheet {
            max-width: 640px; margin: 0 auto; background: #fff;
            border-radius: 14px; border: 1px solid #e2e8f0; padding: 2rem 1.75rem;
            box-shadow: 0 12px 40px rgba(15,23,42,.08);
        }
        .muted { color: #64748b; }
        .brand-row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.25rem; }
        .ufs-logo { max-height: 72px; width: auto; max-width: 220px; object-fit: contain; }
        .arnox { font-weight: 800; font-size: 1.35rem; letter-spacing: -0.02em; }
        .arnox span { color: #7c3aed; }
        .divider { border-top: 1px solid #e2e8f0; margin: 1rem 0; }
        .status-ok {
            display: inline-flex; align-items: center; gap: .4rem;
            background: #ecfdf5; color: #065f46; border: 1px solid #a7f3d0;
            border-radius: 999px; padding: .35rem .85rem; font-weight: 700; font-size: .85rem;
        }
        .totals td { padding: .35rem 0; }
        .totals .grand { font-size: 1.15rem; font-weight: 800; }
        @@media print {
            body { background: #fff; padding: 0; }
            .no-print { display: none !important; }
            .sheet { box-shadow: none; border: none; }
        }
    </style>
</head>
<body>
    <div class="no-print mb-3 text-end">
        <button type="button" class="btn btn-primary btn-sm" onclick="window.print()">Download / Print receipt</button>
        <a class="btn btn-outline-secondary btn-sm" href="@Url.Action("Index", "Customer")">Return to dashboard</a>
    </div>

    <div class="sheet">
        <div class="brand-row">
            <img class="ufs-logo" src="~/images/ufs-logo.webp" asp-append-version="true" alt="University of the Free State" />
            <div class="text-end">
                <div class="arnox">Arnox<span>Pay</span></div>
                <div class="muted small">Secure Payments. Smarter Services.</div>
            </div>
        </div>

        <h1 class="h4 fw-bold mb-1">Payment Receipt</h1>
        <p class="muted small mb-3">University estate payment confirmation · University of the Free State</p>

        <div class="divider"></div>

        <div class="row g-2 small mb-2">
            <div class="col-sm-6"><span class="muted">Customer</span><div class="fw-semibold">@fullName</div></div>
            <div class="col-sm-6"><span class="muted">Student / Staff number</span><div class="fw-semibold">@studentNo</div></div>
            <div class="col-sm-6"><span class="muted">Service</span><div class="fw-semibold">@Model.PaymentType</div></div>
            <div class="col-sm-6"><span class="muted">Account reference</span><div class="fw-semibold">@Model.AccountReference</div></div>
            <div class="col-sm-6"><span class="muted">Transaction reference</span><div class="fw-semibold">@receiptNo</div></div>
            <div class="col-sm-6"><span class="muted">Receipt number</span><div class="fw-semibold">RCP-@Model.Id.ToString("D6")</div></div>
            <div class="col-sm-6"><span class="muted">Payment method</span><div class="fw-semibold">@(Model.PaymentMethod ?? "—")</div></div>
            <div class="col-sm-6"><span class="muted">Date &amp; time</span><div class="fw-semibold">@paidAt.ToLocalTime().ToString("dd MMMM yyyy, HH:mm")</div></div>
        </div>

        <div class="divider"></div>

        <table class="totals w-100 mb-3">
            <tr>
                <td class="muted">Amount</td>
                <td class="text-end fw-semibold">@Model.Amount.ToString("C")</td>
            </tr>
            <tr>
                <td class="muted">Transaction fee</td>
                <td class="text-end">@fee.ToString("C")</td>
            </tr>
            <tr>
                <td class="grand">Total paid</td>
                <td class="text-end grand">@total.ToString("C")</td>
            </tr>
        </table>

        <p class="mb-3">
            <span class="status-ok">✓ PAID / SUCCESSFUL</span>
        </p>
        @if (Model.ReviewedAtUtc.HasValue)
        {
            <p class="muted small">Approved @Model.ReviewedAtUtc.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm")@(string.IsNullOrWhiteSpace(Model.OfficerReference) ? "" : " · Ref " + Model.OfficerReference)</p>
        }

        <p class="muted small mb-0">
            This receipt confirms a successful ArnoxPay payment for university estate services.
            Retain this document for your records.
        </p>
    </div>
</body>
</html>
