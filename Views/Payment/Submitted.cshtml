@model Payment
@{
    ViewData["Title"] = "Payment submitted";
    var submittedItems = Model.Items?.ToList() ?? new List<PaymentItem>();
    var submittedServiceLabel = submittedItems.Count > 1 ? "Multiple Services" : Model.PaymentType.ToString();
}
<div class="content-card fx-success-panel">
    <div class="fx-success-icon" aria-hidden="true">
        <i class="fa-solid fa-check"></i>
    </div>
    <h1 class="h3 fw-bold mb-2">Payment request submitted</h1>
    <p class="text-muted mb-4">
        Your <strong>@submittedServiceLabel</strong> payment of
        <strong>@Model.Amount.ToString("C")</strong> has been submitted successfully and is awaiting review.
    </p>

    <div class="text-start mx-auto mb-4" style="max-width:360px">
        <div class="d-flex justify-content-between border-bottom py-2">
            <span class="text-muted">Reference</span>
            <span class="fw-semibold">#TXN@(Model.Id.ToString().PadLeft(6, '0'))</span>
        </div>
        <div class="d-flex justify-content-between border-bottom py-2">
            <span class="text-muted">Service</span>
            <span class="fw-semibold">@submittedServiceLabel</span>
        </div>
        <div class="d-flex justify-content-between border-bottom py-2">
            <span class="text-muted">Amount</span>
            <span class="fw-semibold">@Model.Amount.ToString("C")</span>
        </div>
        <div class="d-flex justify-content-between border-bottom py-2">
            <span class="text-muted">Date</span>
            <span class="fw-semibold">@Model.SubmittedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</span>
        </div>
        <div class="d-flex justify-content-between py-2">
            <span class="text-muted">Status</span>
            <span class="fx-status pending"><i class="fa-solid fa-clock" aria-hidden="true"></i> Pending review</span>
        </div>
    </div>

    <div class="d-flex flex-wrap justify-content-center gap-2">
        <a class="btn btn-primary" asp-action="Receipt" asp-route-id="@Model.Id">View receipt</a>
        <a class="btn btn-outline-secondary" asp-controller="Customer" asp-action="Index">Back to dashboard</a>
        <a class="btn btn-outline-secondary" asp-action="MyPayments">Payment history</a>
    </div>
</div>
