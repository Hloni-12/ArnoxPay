@model PaymentCreateModel
@{
    ViewData["Title"] = "Make a payment";
}
<div class="fx-pay-shell">
    <div class="content-card">
        <p class="text-uppercase fw-semibold small mb-1" style="letter-spacing:.06em;color:#7c3aed">Secure payment request</p>
        <h1 class="page-title h3 mb-1">What are you paying for?</h1>
        <p class="text-muted mb-4">Submit a request for review. You will receive a confirmation and can track status in Payment History.</p>

        <form method="post" class="row g-3" novalidate>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger col-12"></div>

            <div class="col-12">
                <label asp-for="PaymentType" class="form-label fw-semibold">Service</label>
                <select asp-for="PaymentType" asp-items="Html.GetEnumSelectList<PaymentType>()" class="form-select form-select-lg"></select>
            </div>

            <div class="col-md-6">
                <label asp-for="Amount" class="form-label fw-semibold">Amount (R)</label>
                <input asp-for="Amount" class="form-control form-control-lg" min="0.01" step="0.01" placeholder="0.00" />
                <span asp-validation-for="Amount" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="AccountReference" class="form-label fw-semibold">Account / meter reference</label>
                <input asp-for="AccountReference" class="form-control form-control-lg" placeholder="e.g. meter or student number" />
                <span asp-validation-for="AccountReference" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <label asp-for="Notes" class="form-label fw-semibold">Notes <span class="text-muted fw-normal">(optional)</span></label>
                <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
            </div>

            <div class="col-12">
                <div class="fx-pay-summary">
                    <div class="small text-muted mb-1">You are about to submit</div>
                    <div class="fw-bold">A payment request for the selected service</div>
                    <div class="small text-muted mt-1">Status will start as <strong>Pending</strong> until a financial officer reviews it.</div>
                </div>
            </div>

            <div class="col-12 d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary btn-lg px-4">Confirm payment request</button>
                <a class="btn btn-outline-secondary btn-lg" asp-action="MyPayments">Cancel</a>
            </div>

            <div class="col-12">
                <p class="fx-secure-note mb-0">
                    <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
                    Protected account session · Transaction reference issued after submission
                </p>
            </div>
        </form>
    </div>
</div>
