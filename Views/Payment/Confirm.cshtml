@model Payment
@{
    ViewData["Title"] = "Confirm payment";
    var name = $"{Model.Customer?.AppUser?.FirstName} {Model.Customer?.AppUser?.LastName}".Trim();
}
<div class="fx-pay-shell">
    <div class="content-card">
        <p class="text-uppercase fw-semibold small mb-1" style="letter-spacing:.06em;color:#7c3aed">Step 3 · Confirm your payment</p>
        <h1 class="page-title h3 mb-2">You are about to submit a payment of @Model.Amount.ToString("C") for @Model.PaymentType.</h1>
        <p class="text-muted">Confirm to send this payment for Financial Officer review. It will not be marked as paid until an officer accepts it.</p>

        <ul class="list-unstyled mb-4">
            <li class="mb-1"><strong>Customer:</strong> @name</li>
            <li class="mb-1"><strong>Service:</strong> @Model.PaymentType</li>
            <li class="mb-1"><strong>Amount:</strong> @Model.Amount.ToString("C")</li>
            <li class="mb-1"><strong>Method:</strong> @Model.PaymentMethod</li>
            <li class="mb-1"><strong>Reference:</strong> @Model.TransactionReference</li>
        </ul>

        <div class="fx-pay-summary mb-4">
            <i class="fa-solid fa-lock me-2" aria-hidden="true"></i>
            Status remains <strong>not paid</strong> until authentication, processing, and Financial Officer acceptance succeed.
        </div>

        <a class="btn btn-primary btn-lg" asp-action="Authenticate" asp-route-id="@Model.Id">Continue to authentication</a>
        <a class="btn btn-outline-secondary btn-lg" asp-action="Details" asp-route-id="@Model.Id">Back</a>
    </div>
</div>
