@model Payment
@{
    ViewData["Title"] = "Payment details";
    var gateway = ViewBag.Gateway as ArnoxPay.Infrastructure.IPaymentGateway;
    var items = Model.Items?.ToList() ?? new List<PaymentItem>();
    if (items.Count == 0)
        items.Add(new PaymentItem { PaymentType = Model.PaymentType, Amount = Model.Amount, Description = Model.PaymentType.ToString() });
}
<div class="fx-pay-shell">
    <div class="content-card">
        <p class="text-uppercase fw-semibold small mb-1" style="letter-spacing:.06em;color:#7c3aed">Step 2 · Payment details</p>
        <h1 class="page-title h3 mb-3">Payment summary</h1>

        <div class="table-responsive mb-4">
            <table class="table">
                <thead><tr><th>Item</th><th class="text-end">Amount</th></tr></thead>
                <tbody>
                    @foreach (var item in items)
                    {
                        <tr>
                            <td>@(item.Description ?? item.PaymentType.ToString())</td>
                            <td class="text-end">R @item.Amount.ToString("N2")</td>
                        </tr>
                    }
                    <tr><td>Transaction fee</td><td class="text-end">R0.00</td></tr>
                    <tr class="fw-bold"><td>Total</td><td class="text-end">R @Model.Amount.ToString("N2")</td></tr>
                </tbody>
            </table>
        </div>

        <dl class="row small">
            <dt class="col-sm-4">Reference</dt><dd class="col-sm-8">@Model.TransactionReference</dd>
            <dt class="col-sm-4">Account</dt><dd class="col-sm-8">@Model.AccountReference</dd>
            <dt class="col-sm-4">Status</dt><dd class="col-sm-8"><span class="fx-status pending">Awaiting method selection</span></dd>
        </dl>

        <form method="post" class="mt-3">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
            <label class="form-label fw-semibold">Payment method</label>
            <div class="form-check mb-2">
                <input class="form-check-input" type="radio" name="paymentMethod" id="m1" value="Mastercard" checked />
                <label class="form-check-label" for="m1">Mastercard</label>
            </div>
            <div class="form-check mb-3">
                <input class="form-check-input" type="radio" name="paymentMethod" id="m2" value="Campus Account" />
                <label class="form-check-label" for="m2">Campus Account</label>
            </div>
            <button type="submit" class="btn btn-primary btn-lg">Continue to Verification</button>
        </form>
        <p class="fx-secure-note mt-3 mb-0"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i> Payment is stored in ArnoxPay and only marked paid after Financial Officer approval.</p>
    </div>
</div>
