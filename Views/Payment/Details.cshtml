@model Payment
@{
    ViewData["Title"] = "Payment details";
    var gateway = ViewBag.Gateway as ArnoxPay.Infrastructure.IPaymentGateway;
}
<div class="fx-pay-shell">
    <div class="content-card">
        <div class="alert alert-warning border-0 mb-3" role="status">
            <strong>@(gateway?.EnvironmentName ?? "DEMO PAYMENT ENVIRONMENT")</strong>
            — Authentication has not happened yet.
        </div>
        <p class="text-uppercase fw-semibold small mb-1" style="letter-spacing:.06em;color:#7c3aed">Step 2 · Payment details</p>
        <h1 class="page-title h3 mb-3">Payment summary</h1>

        <div class="table-responsive mb-4">
            <table class="table">
                <thead><tr><th>Item</th><th class="text-end">Amount</th></tr></thead>
                <tbody>
                    <tr><td>@Model.PaymentType</td><td class="text-end">@Model.Amount.ToString("C")</td></tr>
                    <tr><td>Transaction fee</td><td class="text-end">R0.00</td></tr>
                    <tr class="fw-bold"><td>Total</td><td class="text-end">@Model.Amount.ToString("C")</td></tr>
                </tbody>
            </table>
        </div>

        <dl class="row small">
            <dt class="col-sm-4">Reference</dt><dd class="col-sm-8">@Model.TransactionReference</dd>
            <dt class="col-sm-4">Account</dt><dd class="col-sm-8">@Model.AccountReference</dd>
            <dt class="col-sm-4">Status</dt><dd class="col-sm-8"><span class="fx-status pending">Awaiting method selection</span></dd>
        </dl>

        <form method="post" class="mt-3">
            @Html.AntiForgeryToken()
            <label class="form-label fw-semibold">Payment method</label>
            <div class="form-check mb-2">
                <input class="form-check-input" type="radio" name="paymentMethod" id="m1" value="Card/Bank Payment" checked />
                <label class="form-check-label" for="m1">Card / Bank Payment (demo)</label>
            </div>
            <div class="form-check mb-3">
                <input class="form-check-input" type="radio" name="paymentMethod" id="m2" value="Campus Account" />
                <label class="form-check-label" for="m2">Campus Account (demo)</label>
            </div>
            <button type="submit" class="btn btn-primary btn-lg">Continue to Verification</button>
        </form>
        <p class="fx-secure-note mt-3 mb-0"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i> No card numbers, CVVs, or bank passwords are collected.</p>
    </div>
</div>
