@model List<Notification>
@{
    ViewData["Title"] = "Notifications";
    var unread = Model.Count(x => !x.IsRead);
}
<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <h1 class="page-title h2 mb-1">Notifications</h1>
        <p class="text-muted mb-0">
            @if (unread > 0)
            {
                <span>@unread unread notification@(unread == 1 ? "" : "s").</span>
            }
            else
            {
                <span>You're all caught up.</span>
            }
        </p>
    </div>
    @if (unread > 0)
    {
        <form asp-action="MarkAllRead" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-primary btn-sm">Mark all as read</button>
        </form>
    }
</div>

<section class="content-card p-0 overflow-hidden">
@if (Model.Any())
{
    <ul class="list-group list-group-flush">
    @foreach (var n in Model)
    {
        <li class="list-group-item px-3 py-3 @(n.IsRead ? "" : "notif-unread")">
            <div class="d-flex flex-wrap justify-content-between gap-2">
                <div>
                    <div class="fw-semibold">
                        @if (!n.IsRead)
                        {
                            <span class="notif-dot" aria-hidden="true"></span>
                            <span class="visually-hidden">Unread: </span>
                        }
                        @n.Title
                    </div>
                    <p class="mb-1 text-muted">@n.Message</p>
                    <div class="small text-muted">@n.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</div>
                </div>
                <div class="align-self-center">
                    @if (!n.IsRead)
                    {
                        <form asp-action="MarkRead" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@n.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Mark as read</button>
                        </form>
                    }
                    else
                    {
                        <span class="small text-muted">Read@(n.ReadAt.HasValue ? $" · {n.ReadAt.Value.ToLocalTime():dd MMM HH:mm}" : "")</span>
                    }
                </div>
            </div>
        </li>
    }
    </ul>
}
else
{
    <div class="empty-state">No notifications yet.</div>
}
</section>
