@model ArnoxPay.Models.Announcement
@{ViewData["Title"]="Publish announcement";}
<div class="content-card mx-auto" style="max-width:800px"><h1 class="h2">Publish announcement</h1><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control"/><span asp-validation-for="Title" class="text-danger"></span></div><div class="mb-3"><label asp-for="Body" class="form-label">Announcement</label><textarea asp-for="Body" class="form-control" rows="6"></textarea><span asp-validation-for="Body" class="text-danger"></span></div><div class="row g-3"><div class="col-md-4"><label asp-for="Audience" class="form-label"></label><select asp-for="Audience" class="form-select"><option>All</option><option>Customer</option><option>Financial Officer</option><option>Administrator</option></select></div><div class="col-md-4"><label asp-for="Priority" class="form-label"></label><select asp-for="Priority" class="form-select"><option>Low</option><option>Normal</option><option>High</option><option>Urgent</option></select></div><div class="col-md-4"><label asp-for="DeadlineUtc" class="form-label">Deadline</label><input asp-for="DeadlineUtc" type="datetime-local" class="form-control"/></div><div class="col-md-4"><label asp-for="ReminderAtUtc" class="form-label">Reminder time</label><input asp-for="ReminderAtUtc" type="datetime-local" class="form-control"/></div></div><button class="btn btn-primary mt-3">Publish</button></form></div>
