@model List<ArnoxPay.Models.Announcement>
@{ViewData["Title"]="Announcements";}
<div class="d-flex justify-content-between mb-3"><h1 class="h2">Announcements</h1><a asp-action="Create" class="btn btn-primary">Publish announcement</a></div><div class="content-card">@if(!Model.Any()){<p class="text-muted">No announcements published.</p>}@foreach(var a in Model){<article class="border-bottom py-3"><h2 class="h5"><a asp-action="Read" asp-route-id="@a.Id">@a.Title</a> <span class="badge text-bg-secondary">@a.Priority</span></h2><p>@a.Body</p><small>For @a.Audience · Published @a.PublishedAtUtc.ToLocalTime().ToString("g") @if(a.DeadlineUtc.HasValue){<span>· Deadline @a.DeadlineUtc.Value.ToLocalTime().ToString("g")</span>} @if(a.ReminderAtUtc.HasValue){<span>· Reminder @a.ReminderAtUtc.Value.ToLocalTime().ToString("g")</span>}</small></article>}</div>
