@model ArnoxPay.Models.Announcement
@{ViewData["Title"]=Model.Title;}
<article class="content-card"><a asp-action="Inbox">← Announcements</a><div class="mt-3"><span class="badge text-bg-secondary">@Model.Priority</span><span class="badge text-bg-light">@Model.Audience</span></div><h1 class="h2 mt-2">@Model.Title</h1><p class="text-muted">Published @Model.PublishedAtUtc.ToLocalTime().ToString("g") @if(Model.DeadlineUtc.HasValue){<span>· Deadline @Model.DeadlineUtc.Value.ToLocalTime().ToString("g")</span>}</p><p style="white-space:pre-wrap">@Model.Body</p></article>
