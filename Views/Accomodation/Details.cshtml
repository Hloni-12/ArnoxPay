@model AccommodationDetailsViewModel
@{ 
	ViewData["Title"] = Model.Accomodation.Name; 
	var images = Model.Accomodation.Images.OrderByDescending(x => x.IsPrimary).ToList(); 
	var full = Model.OccupiedPlaces >= Model.Accomodation.Capacity; 
}
<div class="mb-4">
	<a class="small text-decoration-none" asp-action="List">← All accomodations</a>
	<h1 class="page-title h2 mt-2 mb-1">@Model.Accomodation.Name</h1>
	<p class="text-muted mb-0">Unit @Model.Accomodation.UnitNumber · @Model.Accomodation.Address · @Model.Accomodation.AccommodationType · @(Model.Accomodation.RoomType?.ToString() ?? "Room type not confirmed") room</p>
</div>
<div class="row g-4">
	<div class="col-lg-7">@if(images.Any()){
		<div id="accommodationCarousel" class="carousel slide rounded-4 overflow-hidden shadow-sm">
			<div class="carousel-inner">@for(var i=0;i<images.Count;i++){<div class="carousel-item @(i==0?"active":"")">
				<img src="@images[i].ImagePath" class="d-block w-100 detail-accommodation-image" alt="@images[i].Caption"/>
			</div>}
		</div>
		@if(images.Count>1){
			<button class="carousel-control-prev" type="button" data-bs-target="#accommodationCarousel" data-bs-slide="prev">
				<span class="carousel-control-prev-icon"></span>
			</button>
			<button class="carousel-control-next" type="button" data-bs-target="#accommodationCarousel" data-bs-slide="next">
				<span class="carousel-control-next-icon"></span>
			</button>}
	</div>}
	else
	{
		<div class="detail-accommodation-image accommodation-placeholder rounded-4">Images will be added by the administrator.</div>
	}
</div>
<div class="col-lg-5">
	<section class="content-card h-100">
		<h2 class="h5">Residence information</h2>
		<p class="text-muted">@(string.IsNullOrWhiteSpace(Model.Accomodation.Description) ? "No additional description has been supplied." : Model.Accomodation.Description)</p>
			<dl class="row small mb-4">
				<dt class="col-5">Monthly rent</dt>
				<dd class="col-7">@(Model.Accomodation.MonthlyRent.HasValue ? Model.Accomodation.MonthlyRent.Value.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-ZA")) : "Not published")</dd>
				<dt class="col-5">Room type</dt><dd class="col-7">@(Model.Accomodation.RoomType?.ToString() ?? "Not confirmed")</dd>
				<dt class="col-5">Capacity</dt>
				<dd class="col-7">@Model.Accomodation.Capacity residents</dd>
				<dt class="col-5">Occupied</dt>
				<dd class="col-7">@Model.OccupiedPlaces places</dd>
				<dt class="col-5">Availability</dt>
				<dd class="col-7">@(full ? "Currently full" : $"{Model.Accomodation.Capacity-Model.OccupiedPlaces} place(s) available")</dd>
					</dl>@if(Model.IsCurrentResident)
					{
						<div class="alert alert-success">You are currently assigned to this accomodation. <a asp-controller="AccommodationIssue" asp-action="Create">Report an issue</a>.</div>
					}
					else if(Model.HasPendingRequest)
					{
						<div class="alert alert-warning">Your residence request is awaiting administrator review.</div>
					}
		else if(!full && User.IsInRole(SystemRoles.Customer))
		{
			<form asp-action="RequestAssignment" method="post"><input name="AccomodationId" value="@Model.Accomodation.Id" type="hidden"/>
			<fieldset class="mb-3">
				<legend class="form-label h6">Do you require an accessible room?</legend>
				<div class="form-check form-check-inline"><input class="form-check-input" type="radio" name="RequiresAccessibleRoom" id="accessibleRoomYes" value="true"/><label class="form-check-label" for="accessibleRoomYes">Yes</label></div>
				<div class="form-check form-check-inline"><input class="form-check-input" type="radio" name="RequiresAccessibleRoom" id="accessibleRoomNo" value="false" checked/><label class="form-check-label" for="accessibleRoomNo">No</label></div>
				<div class="form-text">Choose Yes if you need room features for disability-related access. This request helps the accommodation team consider a suitable room; no diagnosis details are needed.</div>
			</fieldset>
			<label class="form-label" for="CustomerNote">Optional note to administrator</label>
						<textarea class="form-control mb-3" name="CustomerNote" id="CustomerNote" rows="3">

						</textarea>
							<button class="btn btn-primary">Request this accomodation</button>
						</form>
					}
					else if (User.Identity?.IsAuthenticated != true)
                    { <div class="alert alert-info">Please <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Details", "Accomodation", new { id = Model.Accomodation.Id })">sign in</a> as a customer to submit a residence request.</div> }
					else if(full)
					{
						<div class="alert alert-secondary mb-0">This accommodation is currently fully occupied.</div>
					}
	</section>
</div>
</div>
