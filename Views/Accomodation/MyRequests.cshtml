@model List<AccommodationAssignmentRequest>
@{
 ViewData["Title"] = "My residence requests";
}
<div class="d-flex justify-content-between align-items-end mb-4">
	<div>
		<h1 class="page-title h2 mb-1">My residence requests</h1>
		<p class="text-muted mb-0">Track administrator decisions about your accomodation request.</p>
	</div>
	<a class="btn btn-outline-primary" asp-action="List">Browse accomodations</a>
</div>
<section class="content-card p-0 overflow-hidden">
	@if(Model.Any())
	{
		<div class="table-responsive">
			<table class="table table-hover mb-0">
				<thead>
					<tr>
						<th>Accomodation</th>
						<th>Requested</th>
						<th>Status</th>
						<th>Administrator note</th>
					</tr>
				</thead>
					<tbody>@foreach(var request in Model)
						{
							<tr>
								<td>@request.Accomodation?.Name <small class="text-muted d-block">Unit @request.Accomodation?.UnitNumber</small></td>
								<td>@request.RequestedAtUtc.ToLocalTime().ToString("dd MMM yyyy")</td>
								<td><partial name="_StatusBadge" model="@request.Status.ToString()"/></td>
								<td>@request.AdministratorNote</td>
							</tr>
						}
				   </tbody>
			</table>
		</div>
	}
		else
		{
			<div class="empty-state">You have not submitted a residence request.</div>
		}
</section>
