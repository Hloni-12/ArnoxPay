@model List<AccommodationDetailsViewModel>
@{ ViewData["Title"] = "Accommodation"; }
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4"><div><p class="text-primary small fw-semibold mb-1">Residence options</p><h1 class="page-title h2 mb-1">Explore accommodation</h1><p class="text-muted mb-0">Published properties, addresses, current occupancy and available rooms.</p></div>@if(User.IsInRole(SystemRoles.Customer)){<a class="btn btn-outline-primary" asp-action="MyRequests">My residence requests</a>}</div>
<form method="get" asp-action="List" class="content-card mb-4"><div class="row g-3 align-items-end"><div class="col-md-5"><label class="form-label" for="search">Search properties</label><input class="form-control" name="search" id="search" value="@ViewBag.Search" placeholder="Name, address or unit" /></div><div class="col-md-3"><label class="form-label" for="type">Property type</label><select class="form-select" name="type" id="type"><option value="">All types</option>@foreach(var t in Enum.GetValues<AccommodationType>()){<option value="@t" selected="@(ViewBag.Type?.ToString()==t.ToString())">@t</option>}</select></div><div class="col-md-2"><label class="form-label" for="roomType">Room</label><select class="form-select" name="roomType" id="roomType"><option value="">All rooms</option>@foreach(var t in Enum.GetValues<AccommodationRoomType>()){<option value="@t" selected="@(ViewBag.RoomType?.ToString()==t.ToString())">@t</option>}</select></div><div class="col-md-2"><div class="form-check mb-2"><input class="form-check-input" type="checkbox" value="true" name="availableOnly" id="availableOnly" checked="@(ViewBag.AvailableOnly==true)"/><label class="form-check-label" for="availableOnly">Available only</label></div><button class="btn btn-primary w-100">Search</button></div></div></form>
@if(Model.Any()){<div class="row g-4">@foreach(var item in Model){var a=item.Accomodation;var image=a.Images.OrderByDescending(x=>x.IsPrimary).FirstOrDefault();<div class="col-md-6 col-xl-4"><article class="accommodation-card h-100">@if(image is not null){<img src="@image.ImagePath" alt="@(image.Caption ?? a.Name)" class="accommodation-image"/>}else{<div class="accommodation-image accommodation-placeholder">No property photo supplied</div>}<div class="p-4"><div class="d-flex justify-content-between gap-2"><h2 class="h5 mb-1">@a.Name</h2><span class="badge text-bg-light">@a.AccommodationType</span></div><p class="small text-muted mb-2">@a.Address · Unit @a.UnitNumber</p><p class="small mb-2"><span class="badge text-bg-secondary">@(a.RoomType?.ToString() ?? "Room type not confirmed") room</span> · <strong>@(a.MonthlyRent.HasValue ? a.MonthlyRent.Value.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-ZA")) + " / month" : "Rent not published")</strong></p><p class="text-muted small">@(string.IsNullOrWhiteSpace(a.Description)?"":a.Description)</p><div class="small mb-3"><strong>@item.AvailablePlaces</strong> places available · @item.OccupiedPlaces / @a.Capacity occupied</div><div class="d-flex gap-2"><a class="btn btn-outline-primary btn-sm" asp-action="Details" asp-route-id="@a.Id">View details</a>@if(item.IsCurrentResident){<span class="badge text-bg-success">Your residence</span>}else if(item.HasPendingRequest){<span class="badge text-bg-warning">Request pending</span>}else if(item.AvailablePlaces==0){<span class="badge text-bg-secondary">Fully occupied</span>}</div></div></article></div>}</div>}else{<div class="empty-state content-card">No matching published accommodation was found.</div>}
