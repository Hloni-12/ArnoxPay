@model List<Transaction>
@{ ViewData["Title"] = "My transactions"; }<div class="mb-4"><h1 class="page-title h2 mb-1">My transactions</h1><p class="text-muted mb-0">Completed transactions linked to your accepted payments.</p></div><section class="content-card p-0 overflow-hidden">@if(Model.Any()){<div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Reference</th><th>Service</th><th>Amount</th><th>Status</th><th>Completed</th></tr></thead><tbody>@foreach(var t in Model){<tr><td>@t.TransactionReference</td><td>@t.Payment?.PaymentType</td><td>@t.Amount.ToString("C")</td><td><partial name="_StatusBadge" model="@t.Status.ToString()"/></td><td>@t.CompletedAtUtc?.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td></tr>}</tbody></table></div>}else{<div class="empty-state">No transactions yet.</div>}</section>
