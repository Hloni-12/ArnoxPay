@model List<ArnoxPay.Models.ViewModels.CartLine>
@{
    ViewData["Title"] = "Review checkout";
    decimal total = ViewBag.Total is decimal t ? t : Model.Sum(x => x.Amount);
}
<div class="container py-3" style="max-width:720px">
    <a class="btn-arnox btn-arnox-outline btn-arnox-sm mb-3" asp-action="Hub"><i class="fa-solid fa-arrow-left"></i> Add another service</a>
    <h1 class="page-title h3 mb-1">Review &amp; pay</h1>
    <p class="text-muted mb-4">Check each item. You can remove a line or add more services before confirming.</p>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (!Model.Any())
    {
        <div class="empty-state">Your checkout is empty. <a asp-action="Hub">Choose a service</a>.</div>
    }
    else
    {
        <div class="d-flex flex-column gap-3 mb-4">
            @foreach (var line in Model)
            {
                <div class="content-card p-3 d-flex flex-wrap justify-content-between align-items-start gap-2">
                    <div>
                        <div class="fw-bold">@line.Title</div>
                        <div class="small text-muted">@line.Subtitle</div>
                        @if (line.Quantity.HasValue)
                        {
                            <div class="small mt-1">
                                @line.Quantity.Value.ToString("0.####") @line.UnitOfMeasure
                                @if (line.UnitPrice.HasValue)
                                {
                                    <span>· @line.UnitPrice.Value.ToString("C") / @line.UnitOfMeasure</span>
                                }
                            </div>
                        }
                    </div>
                    <div class="text-end">
                        <div class="fw-bold fs-5">@line.Amount.ToString("C")</div>
                        <form method="post" asp-action="RemoveLine" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="lineId" value="@line.LineId" />
                            <button type="submit" class="btn btn-link btn-sm text-danger p-0">Remove</button>
                        </form>
                    </div>
                </div>
            }
        </div>

        <div class="p-4 rounded-3 mb-4" style="background:linear-gradient(135deg,#eef2ff,#f5f3ff);border:1px solid #e0e7ff">
            <div class="d-flex justify-content-between align-items-center">
                <span class="fw-semibold">Grand total</span>
                <span class="fs-3 fw-bold text-primary">@total.ToString("C")</span>
            </div>
            <div class="small text-muted mt-1">One combined payment reference will be created. Items stay pending until Financial Officer acceptance where required.</div>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <form method="post" asp-action="CheckoutCart">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-arnox btn-arnox-primary btn-arnox-lg">
                    <i class="fa-solid fa-lock"></i> Confirm &amp; continue to payment
                </button>
            </form>
            <a class="btn-arnox btn-arnox-outline" asp-action="Hub">Add another service</a>
            <form method="post" asp-action="ClearCart">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-arnox btn-arnox-ghost">Clear all</button>
            </form>
        </div>
    }
</div>
