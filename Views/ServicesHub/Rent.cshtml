@model ArnoxPay.Models.ViewModels.RentPaymentForm
@{
    ViewData["Title"] = "Pay rent";
    var label = ViewBag.AccommodationLabel as string ?? "—";
}
<div class="container py-3" style="max-width:560px">
    <a class="btn-arnox btn-arnox-outline btn-arnox-sm mb-3" asp-action="Hub"><i class="fa-solid fa-arrow-left"></i> Services</a>
    <h1 class="page-title h3 mb-1">Rent</h1>
    <p class="text-muted mb-4">Pay rent for your assigned accommodation. Enter the amount due for the billing period.</p>
    <div class="content-card p-4">
        <div class="small text-muted">Accommodation</div>
        <div class="fw-semibold mb-3">@label</div>
        <form method="post" asp-action="Rent">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label class="form-label fw-semibold" asp-for="BillingPeriod">Billing period</label>
                <input asp-for="BillingPeriod" class="form-control" placeholder="yyyy-MM" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold" asp-for="Amount">Amount due (ZAR)</label>
                <div class="input-group input-group-lg">
                    <span class="input-group-text">R</span>
                    <input asp-for="Amount" class="form-control" type="number" min="0.01" step="0.01" />
                </div>
                <span asp-validation-for="Amount" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="Notes">Notes (optional)</label>
                <input asp-for="Notes" class="form-control" />
            </div>
            <div class="d-flex flex-wrap gap-2">
                <button type="submit" name="action" value="add" class="btn-arnox btn-arnox-outline">Add another service</button>
                <button type="submit" name="action" value="checkout" class="btn-arnox btn-arnox-primary">Review &amp; checkout</button>
            </div>
        </form>
    </div>
</div>
