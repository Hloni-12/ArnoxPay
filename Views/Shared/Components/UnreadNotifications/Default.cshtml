@model (int Count, bool IsStaff)
@{ var count = Model.Count; }
<a class="nav-icon-btn position-relative" asp-controller="@(Model.IsStaff ? "StaffNotification" : "Notification")" asp-action="Index" title="Notifications">
    <i class="fa-regular fa-bell" aria-hidden="true"></i>
    <span class="visually-hidden">Notifications@(count > 0 ? $", {count} unread" : "")</span>
    @if (count > 0) { <span class="notif-badge" aria-hidden="true">@(count > 99 ? "99+" : count.ToString())</span> }
</a>
