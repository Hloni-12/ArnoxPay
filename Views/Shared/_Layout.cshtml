<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ArnoxPay</title>
    <link rel="icon" type="image/svg+xml" href="~/images/arnoxpay-mark.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light app-nav">
            <div class="container-fluid">
                <a class="navbar-brand brand-lockup" asp-controller="Home" asp-action="Index">
                    <svg class="brand-icon" width="40" height="40" viewBox="0 0 64 64" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="apNavFill" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#4f46e5"/>
      <stop offset="100%" stop-color="#7c3aed"/>
    </linearGradient>
  </defs>
  <rect width="64" height="64" rx="16" fill="url(#apNavFill)"/>
  <path d="M32 12 L18 18 V32.5 C18 42 24.5 49.5 32 52.5 C39.5 49.5 46 42 46 32.5 V18 Z" fill="#fff" opacity="0.95"/>
  <path d="M24.5 32.5 L29.5 37.5 L40 25" fill="none" stroke="#4f46e5" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/>
</svg>
                    <span class="brand-text-wrap">
                        <span class="brand-name">Arnox<span class="brand-pay">Pay</span></span>
                        <span class="brand-slogan d-none d-md-inline">Secure Payments. Smarter Services.</span>
                    </span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole(SystemRoles.Administrator))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="AdminHome" asp-action="Index">Dashboard</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="AdminCustomer" asp-action="List">Customers</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="AdminFinancialOfficer" asp-action="List">Financial Officers</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="AdminAccomodation" asp-action="List">Accommodation</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Payment" asp-action="Index">Payments</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="AdminReport" asp-action="Index">Reports</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Profile" asp-action="Index">Profile</a></li>
                            }
                            else if (User.IsInRole(SystemRoles.FinancialOfficer))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Payment" asp-action="Dashboard">Dashboard</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Payment" asp-action="Customers">Customers</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Payment" asp-action="Index">Payments</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="AdminReport" asp-action="Index">Reports</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Reviews" asp-action="Index">Reviews</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Profile" asp-action="Index">Profile</a></li>
                            }
                            else if (User.IsInRole(SystemRoles.Customer))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Customer" asp-action="Index">Dashboard</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Services" asp-action="Index">Services</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Accomodation" asp-action="List">Accommodation</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Payment" asp-action="Checkout">Payments</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Payment" asp-action="MyPayments">Payment History</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Notification" asp-action="Index">Notifications</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Profile" asp-action="Index">Profile</a></li>
                            }
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                            <li class="nav-item"><a class="nav-link" href="#solutions">Services</a></li>
                            <li class="nav-item"><a class="nav-link" href="#how-it-works">How it works</a></li>
                        }
                    </ul>
                    <ul class="navbar-nav align-items-lg-center gap-lg-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole(SystemRoles.Customer))
                            {
                                <li class="nav-item">
                                    @await Component.InvokeAsync("UnreadNotifications")
                                </li>
                                <li class="nav-item">
                                    <a class="nav-icon-btn" asp-controller="Profile" asp-action="Index" title="Profile">
                                        <i class="fa-regular fa-user"></i>
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Profile" asp-action="ChangePassword">Password</a>
                                </li>
                            }
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-dark-pill btn-sm">Sign out</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="pg-nav-login" asp-controller="Account" asp-action="Login">Log In</a>
                            </li>
                            <li class="nav-item">
                                <a class="pg-nav-cta" asp-controller="Account" asp-action="Register">Register</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main>
        @if (ViewData["FullBleed"] as bool? == true)
        {
            @if (TempData["Success"] is string successFull)
            {
                <div class="container-wide pt-3">
                    <div class="alert alert-success alert-dismissible fade show">@successFull<button class="btn-close" type="button" data-bs-dismiss="alert"></button></div>
                </div>
            }
            @if (TempData["Error"] is string errorFull)
            {
                <div class="container-wide pt-3">
                    <div class="alert alert-danger alert-dismissible fade show">@errorFull<button class="btn-close" type="button" data-bs-dismiss="alert"></button></div>
                </div>
            }
            @RenderBody()
        }
        else
        {
            <div class="page-container">
                @if (TempData["Success"] is string success)
                {
                    <div class="alert alert-success alert-dismissible fade show">@success<button class="btn-close" type="button" data-bs-dismiss="alert"></button></div>
                }
                @if (TempData["Error"] is string error)
                {
                    <div class="alert alert-danger alert-dismissible fade show">@error<button class="btn-close" type="button" data-bs-dismiss="alert"></button></div>
                }
                @RenderBody()
            </div>
        }
    </main>

    <footer class="site-footer">
        <div class="container site-footer-main">
            <div class="row g-4 g-lg-4 footer-grid">
                <!-- ArnoxPay -->
                <section class="col-12 col-md-6 col-lg-3 footer-col footer-col-brand" aria-labelledby="footer-about-heading">
                    <div class="footer-brand-row">
                        <svg class="brand-icon" width="36" height="36" viewBox="0 0 64 64" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
                          <defs>
                            <linearGradient id="apFootFill" x1="0%" y1="0%" x2="100%" y2="100%">
                              <stop offset="0%" stop-color="#4f46e5"/>
                              <stop offset="100%" stop-color="#7c3aed"/>
                            </linearGradient>
                          </defs>
                          <rect width="64" height="64" rx="16" fill="url(#apFootFill)"/>
                          <path d="M32 12 L18 18 V32.5 C18 42 24.5 49.5 32 52.5 C39.5 49.5 46 42 46 32.5 V18 Z" fill="#fff" opacity="0.95"/>
                          <path d="M24.5 32.5 L29.5 37.5 L40 25" fill="none" stroke="#4f46e5" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        <div>
                          <h2 id="footer-about-heading" class="footer-heading mb-0">ArnoxPay</h2>
                          <p class="footer-slogan mb-0">Secure Payments. Smarter Services.</p>
                        </div>
                    </div>
                    <p class="footer-about mt-3 mb-0">
                        A secure platform for managing university payments, accounts, and related services.
                    </p>
                </section>

                <!-- Quick Links -->
                <section class="col-12 col-md-6 col-lg-3 footer-col" aria-labelledby="footer-nav-heading">
                    <h2 id="footer-nav-heading" class="footer-heading">Quick Links</h2>
                    <nav aria-label="Footer navigation">
                        <ul class="footer-links">
                            <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                @if (User.IsInRole(SystemRoles.Administrator))
                                {
                                    <li><a asp-controller="AdminHome" asp-action="Index">Dashboard</a></li>
                                    <li><a asp-controller="AdminCustomer" asp-action="List">Customers</a></li>
                                    <li><a asp-controller="Payment" asp-action="Index">Payments</a></li>
                                    <li><a asp-controller="Profile" asp-action="Index">Profile</a></li>
                                }
                                else if (User.IsInRole(SystemRoles.FinancialOfficer))
                                {
                                    <li><a asp-controller="Payment" asp-action="Dashboard">Dashboard</a></li>
                                    <li><a asp-controller="Payment" asp-action="Customers">Customers</a></li>
                                    <li><a asp-controller="Payment" asp-action="Index">Payments</a></li>
                                    <li><a asp-controller="Profile" asp-action="Index">Profile</a></li>
                                }
                                else if (User.IsInRole(SystemRoles.Customer))
                                {
                                    <li><a asp-controller="Customer" asp-action="Index">Dashboard</a></li>
                                    <li><a asp-controller="Profile" asp-action="Index">Profile</a></li>
                                    <li><a asp-controller="Payment" asp-action="MyPayments">Payments</a></li>
                                    <li><a asp-controller="Notification" asp-action="Index">Notifications</a></li>
                                }
                            }
                            else
                            {
                                <li><a asp-controller="Account" asp-action="Login">Log In</a></li>
                                <li><a asp-controller="Account" asp-action="Register">Register</a></li>
                            }
                        </ul>
                    </nav>
                </section>

                <!-- Services -->
                <section class="col-12 col-md-6 col-lg-3 footer-col" aria-labelledby="footer-services-heading">
                    <h2 id="footer-services-heading" class="footer-heading">Services</h2>
                    <ul class="footer-links">
                        <li><a asp-controller="Services" asp-action="Index">Rent &amp; utilities</a></li>
                        <li><a asp-controller="Services" asp-action="Index">Online payments</a></li>
                        <li><a asp-controller="Accomodation" asp-action="List">Accommodation</a></li>
                        <li><a asp-controller="Payment" asp-action="Checkout" asp-route-type="Parking">Parking fees</a></li>
                    </ul>
                </section>

                <!-- Contact Us -->
                <section class="col-12 col-md-6 col-lg-3 footer-col" aria-labelledby="footer-contact-heading">
                    <h2 id="footer-contact-heading" class="footer-heading">Contact Us</h2>
                    <ul class="footer-links">
                        <li><a asp-controller="Home" asp-action="Index" asp-fragment="support">Help &amp; Support</a></li>
                        <li><a asp-controller="Home" asp-action="Index" asp-fragment="contact">Contact</a></li>
                        <li><a asp-controller="Home" asp-action="Privacy">Privacy Policy</a></li>
                        <li><a asp-controller="Home" asp-action="Terms">Terms &amp; Conditions</a></li>
                    </ul>
                </section>
            </div>
        </div>

        <div class="site-footer-bottom">
            <div class="container site-footer-bottom-inner">
                <p class="mb-0 footer-copy">&copy; @DateTime.UtcNow.Year ArnoxPay. All rights reserved.</p>
                <p class="mb-0 footer-legal">
                    <a asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
                    <span class="footer-sep" aria-hidden="true">·</span>
                    <a asp-controller="Home" asp-action="Terms">Terms &amp; Conditions</a>
                </p>
                <p class="mb-0 footer-ufs">University of the Free State</p>
                <p class="mb-0 footer-ufs">Lehlohohonolo Sefako: 2021637349</p>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
